# Per-machine BMAD tooling. Copied in from the local install so the
# bmad skills can render a project-specific workflow; not source, and
# not shared across machines.
/_bmad/

# Python bytecode from the addon test suite. Not source, and a stale .pyc can
# make a repo-wide grep report a string that no longer exists in any source.
__pycache__/
*.py[cod]

# Local VM images. Large per-machine artifacts, never source.
*.qcow2
*.qcow

# Stray HOME emulation. Created when tools run with HOME set to the repo.
# Real copies live in $HOME - never commit the repo-local duplicates.
/.cache/
/.config/
/.docker/
/.local/
/.npm/
/.ssh/
.bash_history
.bash_logout
.bash_profile
.bashrc
.cshrc
.tcshrc
.pytest_cache/
