# SecureAI — cross-boundary constants (AD-11).
#
# This is the ONE file allowed to hold these values.  Everything else --
# docker-compose.yml, the Dockerfile, the CLI, the addon -- refers to them as
# ${SECUREAI_*} and never repeats a literal.
#
# install-fedora.sh creates /etc/secureai/compose.env but does NOT populate it;
# the `secureai` CLI is this file's sole writer, and it seeds /etc/secureai from
# this template on first run while preserving any existing operator edits.

# --- network contract (AD-5) ---------------------------------------------

# Bridge subnet for secureai_net.
SECUREAI_SUBNET=10.211.0.0/24

# Bridge gateway -- also the guest's DNS server (AD-5: Docker's embedded
# resolver does not exist inside a Kata VM).
SECUREAI_GATEWAY=10.211.0.1

# Fixed address of the proxy. The guest reaches the proxy here by literal IP,
# never by Compose service name (AD-5, kata#6688).
SECUREAI_PROXY_IP=10.211.0.10
SECUREAI_PROXY_PORT=8080

# Fixed address of the guest. Pinned so both members of the session have stable
# addresses and neither is addressed by Compose service name (AD-5).
SECUREAI_OPENCODE_IP=10.211.0.20

# The one placeholder the agent is allowed to see. It is not a secret: the
# proxy substitutes the real key on the way out and it never flows back
# (AD-1, AD-10).
SECUREAI_PLACEHOLDER_KEY=sk-secureai-placeholder

# --- host paths (AD-16) ----------------------------------------------------
# These belong here too, because docker-compose.yml references them as ${...}
# and nothing else may hold a literal absolute path used by a bind mount.

# Sole source of truth. The CLI is its only writer; the installer creates it
# empty.
SECUREAI_ETC_DIR=/etc/secureai

# Runtime copy the proxy mounts read-only. Seeded from SECUREAI_ETC_DIR.
SECUREAI_VAR_DIR=/var/lib/secureai

# The proxy's mitmproxy confdir. It lives INSIDE SECUREAI_VAR_DIR so that the CA
# published by `secureai ca export` is the same CA the proxy uses (AD-12); it is
# bind-mounted separately because it is the one path the proxy must write.
SECUREAI_CA_DIR=/var/lib/secureai/ca

# Session workspace: the guest's only writable path, removed with the session.
SECUREAI_WORKSPACE=/var/lib/secureai/workspace

# --- group ownership (AD-7) ------------------------------------------------
# The proxy container drops to an unprivileged user (its entrypoint gosu-drops
# to `mitmproxy`), and bind mounts preserve the host's uid/gid and mode. A 0700
# root-owned directory would therefore be unreadable by the very process that
# must read policy. proxy/Dockerfile pins that user to this gid, and the CLI
# groups the runtime config to it -- readable by root and the proxy, and
# nothing else.
SECUREAI_PROXY_GID=1000

# --- images (AD-6, AD-9) ---------------------------------------------------
# Both are built locally by `secureai build`. The proxy tag must NOT be the
# upstream mitmproxy tag: our addon is baked in at build time, and mitmdump
# would otherwise be pointed at an addon path absent from the image.
#
# Pinned by design -- the PRD rules out an upgrade path, so a pin that ages out
# is a known accepted cost.
SECUREAI_PROXY_IMAGE=secureai/proxy:12.2.3
SECUREAI_OPENCODE_IMAGE=secureai/opencode:1.18.34
